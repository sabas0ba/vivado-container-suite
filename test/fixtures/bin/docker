#!/usr/bin/env bash
# Fake container engine for the test suite.
#
# Records its argv, one argument per line, in $VVD_TEST_ARGV so tests can assert
# on the exact command the CLI assembled.  Behaviour is steered by:
#   VVD_TEST_ENGINE_BROKEN=1   `info` fails (engine installed but unusable)
#   VVD_TEST_IMAGE_MISSING=1   `image inspect` fails
#   VVD_TEST_RUN_STATUS=N      `run` exits with N
#   VVD_TEST_RUN_STDOUT=text   `run` prints text
set -uo pipefail

if [ -n "${VVD_TEST_ARGV:-}" ]; then
  printf '%s\n' "$@" >>"$VVD_TEST_ARGV"
fi

case "${1:-}" in
  info)
    [ "${VVD_TEST_ENGINE_BROKEN:-0}" = "1" ] && exit 1
    echo "fake engine"
    exit 0 ;;
  image)
    if [ "${2:-}" = "inspect" ]; then
      [ "${VVD_TEST_IMAGE_MISSING:-0}" = "1" ] && exit 1
      echo '[{"Id":"sha256:deadbeef"}]'
      exit 0
    fi
    exit 0 ;;
  run)
    [ -n "${VVD_TEST_RUN_STDOUT:-}" ] && printf '%s\n' "$VVD_TEST_RUN_STDOUT"
    exit "${VVD_TEST_RUN_STATUS:-0}" ;;
  build|pull|tag|push)
    exit "${VVD_TEST_RUN_STATUS:-0}" ;;
  *)
    exit 0 ;;
esac
